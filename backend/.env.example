# ========================================
# DATABASE CONFIGURATION
# ========================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_secure_password
DB_NAME=whatsapp_ticketing

# ========================================
# SERVER CONFIGURATION
# ========================================
PORT=5000
NODE_ENV=production
# Used for CORS config - point this to your actual deployed frontend URL
FRONTEND_URL=https://your-domain.com

# ========================================
# AUTHENTICATION
# ========================================
# Generate a secure random string for JWT secret
JWT_SECRET=generate_a_very_long_random_string_here_for_production

# ========================================
# META / WHATSAPP CONFIGURATION
# ========================================
# To get these values:
# 1. Go to https://developers.facebook.com/
# 2. Open your App > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_from_meta
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
# Note: For production, use a Permanent Token (System User), NOT the temporary 24h token
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token
# App Secret from Meta App Dashboard > Settings > Basic
WHATSAPP_APP_SECRET=your_app_secret
# Any secure string you want. Enter this exact string in Meta Webhook configuration.
WHATSAPP_VERIFY_TOKEN=my_secure_webhook_verify_token

# Set to true for local testing without real WhatsApp account, false for production
USE_SIMULATOR=false

# ========================================
# ADMIN PANEL
# ========================================
ADMIN_PANEL_URL=https://your-domain.com
